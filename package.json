{
  "name": "service-health-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3102",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3102",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "import": "node --env-file-if-exists=.env.local scripts/import.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
